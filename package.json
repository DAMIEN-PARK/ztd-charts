{
  "name": "ztd-charts-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm --filter ztd-charts build && pnpm --filter ztd-charts-cli build && pnpm --filter ztd-charts-mcp build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --parallel run typecheck",
    "lint": "eslint .",
    "size": "size-limit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@size-limit/preset-small-lib": "14.3.0",
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "size-limit": "14.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
